# Copy this file to .env and fill in your own values. Never commit or share the real .env.

# Signs the login session cookie. Use any long random string, for example the output of:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Without it the backend makes a temporary key, and everyone is logged out when it restarts.
SESSION_SECRET=replace-with-a-long-random-string

# Set to 1 when the site is served over HTTPS, so the session cookie is only sent securely.
COOKIE_SECURE=0

# How the shop agent signs in to Claude (through the Claude Agent SDK). Set ONE of these.
# 1. A Claude subscription token: run `claude setup-token` (see README.md) and paste the token here.
CLAUDE_CODE_OAUTH_TOKEN=your-claude-code-oauth-token-here
# 2. Or an Anthropic API key from https://console.anthropic.com (used only if no token is set above).
# ANTHROPIC_API_KEY=your-anthropic-api-key-here
